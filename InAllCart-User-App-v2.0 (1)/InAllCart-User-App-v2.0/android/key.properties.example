# Release signing configuration template.
#
# 1. Generate a keystore (see SIGNING.md for the full guide):
#      keytool -genkey -v -keystore upload-keystore.jks -storetype JKS \
#        -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# 2. Copy this file to "key.properties" in the same folder (android/).
# 3. Fill in the values below with your keystore details.
# 4. Place your .jks file somewhere safe and point storeFile at it.
#
# IMPORTANT: key.properties and your .jks file must NEVER be committed to
# version control. They are already listed in android/.gitignore.

storePassword=YOUR_KEYSTORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=upload
# Path is resolved relative to the android/ folder.
storeFile=upload-keystore.jks
